# AI Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# Optional model override for NVIDIA NIM (default: nvidia/llama-3.1-nemotron-70b-instruct)
# NVIDIA_MODEL=

# Gateway Auth (required in production)
# Set a strong random token, e.g. `openssl rand -hex 32`
GATEWAY_API_TOKEN=

# Dev only: allow running without GATEWAY_API_TOKEN
# ALLOW_UNAUTHENTICATED=true

# Postgres (Supabase)
DATABASE_URL=
TEST_DATABASE_URL=
# Optional: path to CA cert for verified TLS (if not set, uses rejectUnauthorized: false with a warning)
DATABASE_CA_CERT_PATH=
# Optional: connection timeout in milliseconds, default 10000
PG_CONNECT_TIMEOUT_MS=

# Provider call deadline in milliseconds, default 30000
PROVIDER_TIMEOUT_MS=