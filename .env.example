# AI Provider API Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# Optional model override for NVIDIA NIM (default: nvidia/llama-3.1-nemotron-70b-instruct)
# NVIDIA_MODEL=

# Optional model overrides (empty = built-in default)
# OPENAI_MODEL=
# GEMINI_MODEL=
# CLAUDE_MODEL=

# Gateway Auth (required in production)
# Set a strong random token, e.g. `openssl rand -hex 32`
GATEWAY_API_TOKEN=

# Dev only: allow running without GATEWAY_API_TOKEN
# ALLOW_UNAUTHENTICATED=true

# Supabase Auth (both must be set or both empty)
SUPABASE_URL=
# Public anon key only; never the service_role key
SUPABASE_ANON_KEY=
# UUID of the owner's Supabase user; the legacy token then acts as this user; empty means legacy rows
OWNER_USER_ID=
# true = the old GATEWAY_API_TOKEN stops working
DISABLE_LEGACY_TOKEN=

# Postgres (Supabase)
DATABASE_URL=
# Startup guard: server exits when set true and DATABASE_URL is empty (set true in production)
REQUIRE_DATABASE=
TEST_DATABASE_URL=
# Optional: path to CA cert for verified TLS (if not set, uses rejectUnauthorized: false with a warning)
DATABASE_CA_CERT_PATH=
# Optional: connection timeout in milliseconds, default 10000
PG_CONNECT_TIMEOUT_MS=

# Provider call deadline in milliseconds, default 30000
PROVIDER_TIMEOUT_MS=
# KEY_ENCRYPTION_SECRET: 32 bytes in base64 (node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"), provider keys encrypted AES-256-GCM
KEY_ENCRYPTION_SECRET=
